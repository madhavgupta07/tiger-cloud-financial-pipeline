# Copy to .env and fill in your own values. Never commit .env.

# Twelve Data API key (free tier is enough): https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=your_twelve_data_api_key

# Tiger Cloud connection. Paste the service URI from the Tiger Cloud console
# (it already includes user, password, host, port and sslmode=require).
DATABASE_URL=postgres://tsdbadmin:password@host:port/tsdb?sslmode=require

# Alternatively, use discrete PG* variables instead of DATABASE_URL:
# PGHOST=your-service.abc123.tsdb.cloud.timescale.com
# PGPORT=12345
# PGDATABASE=tsdb
# PGUSER=tsdbadmin
# PGPASSWORD=your_password
# PGSSLMODE=require

# Symbols to subscribe to (stocks and/or crypto pairs), comma separated.
SYMBOLS=BTC/USD,ETH/USD,MSFT,AAPL

# In-memory batching.
MAX_BATCH_SIZE=100
FLUSH_INTERVAL_SECONDS=10
